{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "移动端能力：落盘所需全部权限（含方案A的自定义命令与 SAF 兜底的文件写入）",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-open",
    "fs:allow-write",
    "allow-open-file",
    "allow-write-chunk",
    "allow-write-chunk-b64",
    "allow-close-file",
    "allow-abort-file",
    "allow-resolve-save-path",
    "allow-diagnostics-capture",
    "allow-diagnostics-query",
    "allow-diagnostics-export",
    "allow-diagnostics-clear",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "arkpulse-android-fs:allow-mediastore-insert",
    "arkpulse-android-fs:allow-saf-create-child",
    "arkpulse-android-fs:allow-saf-take-permission",
    "arkpulse-android-fs:allow-show-save-dialog",
    "arkpulse-android-fs:allow-set-keep-screen-on"
  ],
  "remote": {
    "urls": ["https://flashdrop.pages.dev"]
  }
}
