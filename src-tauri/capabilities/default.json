{
  "identifier": "default",
  "description": "Default capability for FlashDrop remote frontend",
  "windows": ["main"],
  "permissions": [
    "allow-open-file",
    "allow-write-chunk",
    "allow-write-chunk-b64",
    "allow-close-file",
    "allow-abort-file",
    "allow-resolve-save-path"
  ],
  "remote": {
    "urls": ["https://flashdrop.pages.dev"]
  }
}
