{
  "identifier": "default",
  "description": "Default capability for ArkPulse remote frontend",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-file",
    "allow-write-chunk",
    "allow-write-chunk-b64",
    "allow-close-file",
    "allow-abort-file",
    "allow-resolve-save-path",
    "allow-diagnostics-capture",
    "allow-diagnostics-query",
    "allow-diagnostics-export",
    "allow-diagnostics-clear",
    "dialog:allow-save",
    "dialog:allow-open"
  ],
  "remote": {
    "urls": ["https://flashdrop.pages.dev"]
  }
}
