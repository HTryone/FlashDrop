# 依赖
node_modules/

# Cloudflare Wrangler 本地缓存（含 state/日志，不入库）
.wrangler/

# 运行时上传数据（由 server.mjs 自动创建）
uploads/

# 自签名 HTTPS 证书（含私钥，不入库）
certs/

# 日志
server.log
*.log

# 构建产物（Vite 将输出 dist/）
dist/

# Tauri Rust 编译缓存（巨量，绝不入库）
src-tauri/target/

# ========== 自动生成 / 构建产物（绝不入库，由 tauri 命令再生）==========
# 以下均为工具链自动生成，非手写源码；构建时重新产出，入库只会污染历史。
# - gen/            : tauri android/ios 生成的原生工程壳
# - autogenerated/  : 权限清单（主工程 tauri-build 生成 / 插件各自 build.rs 生成）
# - android/.tauri/ : 插件 Kotlin 被 tauri 注入的 Tauri API 包装层
src-tauri/gen/
**/permissions/autogenerated/
src-tauri/plugins/*/android/.tauri/

# ========== 核心手写源码（保留，勿在上方忽略）==========
# 手写核心：src/tauri/*.ts（前端 bridge）、src-tauri/src/**/*.rs（Rust 逻辑）、
# src-tauri/plugins/*/src/lib.rs + android/**/*.kt（插件原生）、
# src-tauri/splash/（壳层遮罩资源）、src-tauri/icons/（图标）、tauri.conf.json、Cargo.lock（锁文件）

# Tauri 图标源图（保留生成的 .ico/.icns/.png，忽略重生成用的源）
src-tauri/icons/source.png

# 打包产物统一输出目录（exe/apk 放这里，绝不入库）
releases/

# Android 自签名 keystore 与密码（含私钥，绝不入库）
src-tauri/release-key.jks
src-tauri/keystore.env

# 本地 NSIS 打包器（Tauri 打 nsis 包所需）。默认走网络下载；
# 若网络下不动，在 tauri:build 前加 set "NSIS_PATH=toolbox\nsis" 切本地。
# 不入库，避免仓库胀；换机器需自行放置或联网拉取。
toolbox/nsis/

# AI 工作区数据，不进仓库
.workbuddy/

# 系统文件
.DS_Store
Thumbs.db
*.lnk

# 临时大文件测试样本（勿入库）
test_*.bin
*.bin

# 测试专用文件夹（存放测试样本/脚本，绝不入库）
/test-assets/

# 临时文档/任务清单（不入库，本地参考）
/tmp/
# Worker dry-run / 构建临时产物（不入库）
/conduit/tmp/
/conduit-tus/tmp/
