{
  "name": "flashdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "闪传 FlashDrop · 大文件分片续传与端到端加密传输（Vue3 + TS + Vite + tus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "start": "node server.mjs",
    "dev:server": "nodemon --watch server.mjs server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@tus/file-store": "^2.1.0",
    "@tus/s3-store": "^1.6.0",
    "@tus/server": "^2.4.2",
    "agent-browser": "^0.27.0",
    "archiver": "^6.0.2",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "selfsigned": "^5.5.0",
    "streamsaver": "^2.0.6",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.13",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
